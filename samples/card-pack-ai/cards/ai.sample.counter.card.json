                  "csx": "// AI 样例·反制：命中即 ctx.Stop()——本次指令的结算段不执行（不发 card.played），照常扣费离手。\nFunc<Orc.Game.Triggers.CardTriggerView, Context, CancellationToken, Task> HandleAsync = (view, ctx, ct) =>\n{\n    ctx.Stop();\n    return Task.CompletedTask;\n};\n",
                  "version": 1
                }
              ],
              "version": 1
            },
            "otherTriggers": [],
            "wrappers": [],
            "injects": []
          }
