        "handler": {
          "id": "keyword.repair#onTurnStart",
          "entry": "HandleAsync",
          "script": "Func<dynamic, Context, CancellationToken, Task> HandleAsync = async (view, ctx, ct) =>\n{\n    if (view.Host is not Orc.Game.Cards.UnitCard host) { return; }\n    if (view.Player is not Orc.Game.Players.Player current || !object.ReferenceEquals(host.Owner, current)) { return; }\n    if (!host.TryGetData<Orc.Game.Cards.ActionRecordData>(out var record)) { return; }\n    if (record.TurnMoves != 0 || record.TurnAttacks != 0) { return; }\n    if (host.GetData<Orc.Game.Cards.UnitStateData>().IsDestroyed) { return; }\n\n    await host.RepairDefenseAsync(ct); // 抢修：回满\n};\n"
        }
      },
