        "handler": {
          "id": "diy.memorial.effect#onPlayed",
          "entry": "HandleAsync",
          "script": "Func<dynamic, Context, CancellationToken, Task> HandleAsync = async (view, ctx, ct) =>\n{\n    if (view.Card is not Orc.Cards.Card played)\n    {\n        return;\n    }\n\n    if (!object.ReferenceEquals(played, view.Host))\n    {\n        return;\n    }\n\n    var runtime = Orc.Game.Effects.EffectRuntime.ResolveFor(played);\n    if (runtime is null || ctx.Engine is null)\n    {\n        return;\n    }\n\n    ctx.Engine.Variables.TryGet<int>(\"diy.example3.destroyed\", out var count);\n    if (count <= 0)\n    {\n        return;\n    }\n\n    var owner = (played as Orc.Game.Cards.CardBase)?.Owner;\n    var hq = owner?.Hq;\n    if (hq is not null)\n    {\n        await runtime.BuffAsync(hq, 0, count, Orc.Game.Effects.EffectDuration.Permanent, ct, played);\n    }\n};\n"
        }
      },
      {
        "name": "onDied",
        "visibility": [
          "callable",
          "mountable"
        ],
        "view": {
