            }
          ]
        },
        "handler": {
          "id": "diy.memorial.effect#onDied",
          "entry": "HandleAsync",
          "script": "Func<dynamic, Context, CancellationToken, Task> HandleAsync = async (view, ctx, ct) =>\n{\n    if (ctx.Engine is null)\n    {\n        await Task.CompletedTask;\n        return;\n    }\n\n    var variables = ctx.Engine.Variables;\n    variables.TryGet<int>(\"diy.example3.destroyed\", out var count);\n    variables.Set(\"diy.example3.destroyed\", count + 1);\n    await Task.CompletedTask;\n};\n"
        }
      }
