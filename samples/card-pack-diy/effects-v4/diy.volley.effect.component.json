        "handler": {
          "id": "diy.volley.effect#onPlayed",
          "entry": "HandleAsync",
          "script": "Func<dynamic, Context, CancellationToken, Task> HandleAsync = async (view, ctx, ct) =>\n{\n    if (view.Card is not Orc.Cards.Card played)\n    {\n        return;\n    }\n\n    if (!object.ReferenceEquals(played, view.Host))\n    {\n        return;\n    }\n\n    var runtime = Orc.Game.Effects.EffectRuntime.ResolveFor(played);\n    if (runtime is null)\n    {\n        return;\n    }\n\n    for (var i = 0; i < 3; i++)\n    {\n        var picked = await runtime.SelectAsync(played, new Orc.Game.Effects.EffectSelector(\"random\", null, null, null, null, 1));\n        if (picked.Count == 0)\n        {\n            break;\n        }\n\n        await runtime.DamageAsync(picked[0], 1, played, ct);\n    }\n};\n"
        }
      }
    ],
    "mounts": [
      {
        "target": "engine#card.played",
        "member": "onPlayed"
      }
    ],
