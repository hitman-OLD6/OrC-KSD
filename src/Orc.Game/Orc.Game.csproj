<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Orc.Game</AssemblyName>
    <RootNamespace>Orc.Game</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orc\Orc.csproj" />
    <!-- 前端资产迁移 S1/S7：中立 UI 契约（零依赖 DTO）位于本层之下 ⇒ 游戏层可托管 UI 面向契约（投影接口）。 -->
    <ProjectReference Include="..\Orc.UI.Contracts\Orc.UI.Contracts.csproj" />
    <!-- DSL 可运行（E1-34）：游戏层默认装配 csx 求值器（内核保持零依赖，实现由 satellite 提供）。 -->
    <ProjectReference Include="..\Orc.Script\Orc.Script.csproj" />
    <!-- handler DSL（S4）：动作面登记用 [HandlerDslActionFace] 等标注，命名空间固定 Orc.Game.Effects.HandlerDsl。
         引擎侧只**标注**，扫描与生成在 Orc.HandlerDsl 内（内核仍不引用它）。 -->
    <ProjectReference Include="..\Orc.HandlerDsl\Orc.HandlerDsl.csproj" />
  </ItemGroup>

  <!-- 效果解析器的资产：模板效果（*.tpl.json）、op 语句模板（*.csx.tpl）、外置词表（Lexicon/*.json）随程序集输出。 -->
  <ItemGroup>
    <None Update="EffectParsing/Templates/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="EffectParsing/Lexicon/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 词条效果库（批 4 数据化）：词条效果的数据壳制品（*.prefab.json）随程序集输出（沿效果解析资产先例）。 -->
  <ItemGroup>
    <None Update="Cards/KeywordPrefabs/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 资产化 S12：内置插件享有游戏层内部访问（内置判定器类为 internal；三方插件只能用 public 面 ＋ IMatchServices）。 -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Orc.Plugins.BuiltIn</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>


</Project>
